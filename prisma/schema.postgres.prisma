generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js ─────────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String    @unique
  emailVerified     DateTime?
  image             String?
  passwordHash      String?
  active            Boolean   @default(true)
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  memberships SchoolMembership[]
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Tenancy ─────────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schools School[]

  @@map("tenants")
}

model School {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String
  currency  String   @default("USD")
  timezone  String   @default("Africa/Harare")
  enableRanking Boolean @default(false)
  motto              String?
  address            String?
  phone              String?
  email              String?
  website            String?
  registrationNumber String?
  bankDetails        String?
  logoPath           String?
  enabledModules     String?
  // Prevailing exchange rate: ZiG units per 1 USD, set daily by the school.
  exchangeRateZwgPerUsd String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  memberships             SchoolMembership[]
  reportWeightings        ReportWeighting[]
  reportApprovals         ReportApproval[]
  lessonPlans             LessonPlan[]
  studentNotes            StudentNote[]
  notifications           Notification[]
  healthRecords           HealthRecord[]
  safeguardingCases       SafeguardingCase[]
  specialNeeds            SpecialNeed[]
  assignments             Assignment[]
  curriculumTopics        CurriculumTopic[]
  pickupAuthorizations    PickupAuthorization[]
  clubs                   Club[]
  clubMemberships         ClubMembership[]
  schoolTrips             SchoolTrip[]
  tripParticipants        TripParticipant[]
  academicYears           AcademicYear[]
  gradeLevels             GradeLevel[]
  classrooms              Classroom[]
  guardians               Guardian[]
  students                Student[]
  studentEnrollments      StudentEnrollment[]
  studentDocuments        StudentDocument[]
  staffAttendance        StaffAttendance[]
  onlinePayments         OnlinePayment[]
  paymentProofs          PaymentProof[]
  attendanceRegisters     AttendanceRegister[]
  attendanceSettings      AttendanceSettings?
  attendanceNotifications AttendanceNotification[]
  auditLogs               AuditLog[]
  terms                   Term[]
  subjects                Subject[]
  classSubjects           ClassSubject[]
  gradingBands            GradingBand[]
  assessments             Assessment[]
  reportCards             ReportCard[]
  reportCardResults       ReportCardResult[]
  timetableEntries        TimetableEntry[]
  feeInvoices             FeeInvoice[]
  feeInvoiceItems         FeeInvoiceItem[]
  feeTemplates            FeeTemplate[]
  payments                Payment[]
  paymentAllocations      PaymentAllocation[]
  financeReversals        FinanceReversal[]
  financeIdempotencyKeys  FinanceIdempotencyKey[]
  admissionApplications   AdmissionApplication[]
  staffProfiles           StaffProfile[]
  departments             Department[]
  studentLeaderships      StudentLeadership[]
  incomeProjects          IncomeProject[]
  schoolLedgerEntries     SchoolLedgerEntry[]
  projectStockItems       ProjectStockItem[]
  stockMovements          StockMovement[]
  suppliers               Supplier[]
  projectBudgets          ProjectBudget[]
  examSessions            ExamSession[]
  examSeats               ExamSeat[]
  leaveRequests           LeaveRequest[]
  payrollRuns             PayrollRun[]
  payrollEntries          PayrollEntry[]
  announcements           Announcement[]
  communicationOutbox     CommunicationOutbox[]
  disciplineIncidents     DisciplineIncident[]
  clinicVisits            ClinicVisit[]
  libraryBooks            LibraryBook[]
  libraryCopies           LibraryCopy[]
  libraryLoans            LibraryLoan[]
  boardingDormitories     BoardingDormitory[]
  boardingAllocations     BoardingAllocation[]
  transportVehicles       TransportVehicle[]
  transportRoutes         TransportRoute[]
  transportAssignments    TransportAssignment[]
  inventoryAssets         InventoryAsset[]
  assetMaintenance        AssetMaintenance[]
  schoolEvents            SchoolEvent[]

  @@unique([tenantId, code])
  @@map("schools")
}

model SchoolMembership {
  id          String   @id @default(cuid())
  schoolId    String
  userId      String
  displayName String
  role        String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  classroomsAsTeacher    Classroom[]             @relation("ClassroomTeacher")
  classSubjectsAsTeacher ClassSubject[]          @relation("ClassSubjectTeacher")
  timetableAsTeacher     TimetableEntry[]        @relation("TimetableTeacher")
  documentsUploaded      StudentDocument[]       @relation("DocumentUploader")
  registersSubmitted     AttendanceRegister[]    @relation("RegisterSubmitter")
  registersLocked        AttendanceRegister[]    @relation("RegisterLocker")
  attendanceMarked       AttendanceEntry[]
  staffAttendanceMarked  StaffAttendance[]
  onlinePaymentsInitiated OnlinePayment[]
  paymentProofsReviewed   PaymentProof[]
  assessmentsCreated     Assessment[]
  marksEntered           AssessmentMark[]
  reportsGenerated       ReportCard[]            @relation("ReportGenerator")
  reportsPublished       ReportCard[]            @relation("ReportPublisher")
  invoicesCreated        FeeInvoice[]
  paymentsRecorded       Payment[]
  allocationsMade        PaymentAllocation[]
  reversalsMade          FinanceReversal[]
  idempotencyKeys        FinanceIdempotencyKey[]
  applicationsCreated    AdmissionApplication[]
  staffProfile           StaffProfile?
  leaveRequested         LeaveRequest[]          @relation("LeaveRequester")
  leaveDecided           LeaveRequest[]          @relation("LeaveDecider")
  payrollCreated         PayrollRun[]            @relation("PayrollCreator")
  payrollApproved        PayrollRun[]            @relation("PayrollApprover")
  announcementsCreated   Announcement[]
  disciplineReported     DisciplineIncident[]
  clinicVisits           ClinicVisit[]
  libraryLoansIssued     LibraryLoan[]
  boardingAssigned       BoardingAllocation[]
  transportAssigned      TransportAssignment[]
  maintenanceRecorded    AssetMaintenance[]
  eventsCreated          SchoolEvent[]
  auditActions           AuditLog[]
  reportApprovals ReportApproval[]
  lessonPlans     LessonPlan[]
  studentNotes    StudentNote[]
  notifications   Notification[]
  safeguardingReported  SafeguardingCase[] @relation("SafeguardingReporter")
  safeguardingOfficer   SafeguardingCase[] @relation("SafeguardingOfficer")
  specialNeeds          SpecialNeed[]
  assignments           Assignment[]
  pickupAuthorizations  PickupAuthorization[]
  clubsCoordinated      Club[]
  tripsCoordinated      SchoolTrip[]

  @@unique([schoolId, userId])
  @@index([userId])
    examInvigilations ExamSession[] @relation("ExamInvigilator")

  @@map("school_memberships")
}

// ─── Academic Structure ──────────────────────────────────────────────────────

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  startDate DateTime
  endDate   DateTime
  status    String   @default("planned")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school              School               @relation(fields: [schoolId], references: [id])
  terms               Term[]
  classrooms          Classroom[]
  studentEnrollments  StudentEnrollment[]
  attendanceRegisters AttendanceRegister[]
  timetableEntries    TimetableEntry[]
  studentLeaderships  StudentLeadership[]

  @@unique([schoolId, name])
  @@index([schoolId, status])
  @@map("academic_years")
}

model GradeLevel {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  gradeOrder  Int
  description String?
  // Infant/ECD levels report descriptors (Emerging..Proficient) — no percentages.
  descriptorOnly Boolean @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school             School              @relation(fields: [schoolId], references: [id])
  classrooms         Classroom[]
  studentEnrollments StudentEnrollment[]
  feeTemplates       FeeTemplate[]

  @@unique([schoolId, gradeOrder])
  @@unique([schoolId, name])
  @@map("grade_levels")
}

model Classroom {
  id             String   @id @default(cuid())
  schoolId       String
  name           String
  yearNumber     Int      @map("academic_year")
  academicYearId String?  @map("academic_year_id")
  gradeLevelId   String?  @map("grade_level_id")
  classTeacherId String?  @map("class_teacher_id")
  room           String?
  active         Boolean  @default(true)
  capacity       Int      @default(40)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School            @relation(fields: [schoolId], references: [id])
  year         AcademicYear?     @relation(fields: [academicYearId], references: [id])
  gradeLevel   GradeLevel?       @relation(fields: [gradeLevelId], references: [id])
  classTeacher SchoolMembership? @relation("ClassroomTeacher", fields: [classTeacherId], references: [id])

  students            Student[]
  studentEnrollments  StudentEnrollment[]
  attendanceRegisters AttendanceRegister[]
  classSubjects       ClassSubject[]
  timetableEntries    TimetableEntry[]
  studentLeaderships  StudentLeadership[]

  @@unique([schoolId, yearNumber, name])
    examSessions ExamSession[]

  @@map("classrooms")
}

model Term {
  id             String   @id @default(cuid())
  schoolId       String
  academicYearId String
  name           String
  termNumber     Int
  startDate       DateTime
  endDate         DateTime
  status          String   @default("planned")
  resultsLockedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school       School       @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  assessments      Assessment[]
  feeInvoices      FeeInvoice[]
  reportCards      ReportCard[]
  timetableEntries TimetableEntry[]
examSessions      ExamSession[]
  lessonPlans LessonPlan[]

  @@unique([academicYearId, termNumber])
  @@index([schoolId, status])
  @@map("terms")
}

model Subject {
  id         String   @id @default(cuid())
  schoolId   String
  code       String
  name       String
  department String?
  level      String   @default("all")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school        School         @relation(fields: [schoolId], references: [id])
  classSubjects ClassSubject[]
  reportWeightings ReportWeighting[]
  studentNotes     StudentNote[]

  @@unique([schoolId, code])
  @@index([schoolId, active])
    examSessions ExamSession[]

  @@map("subjects")
}

model ClassSubject {
  id          String   @id @default(cuid())
  schoolId    String
  classroomId String
  subjectId   String
  teacherId   String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school    School            @relation(fields: [schoolId], references: [id])
  classroom Classroom         @relation(fields: [classroomId], references: [id])
  subject   Subject           @relation(fields: [subjectId], references: [id])
  teacher   SchoolMembership? @relation("ClassSubjectTeacher", fields: [teacherId], references: [id])

  assessments      Assessment[]
  timetableEntries TimetableEntry[]
  lessonPlans LessonPlan[]
  assignments       Assignment[]
  curriculumTopics  CurriculumTopic[]

  @@unique([classroomId, subjectId])
  @@index([schoolId, teacherId])
  @@map("class_subjects")
}

model GradingBand {
  id         String   @id @default(cuid())
  schoolId   String
  name       String
  minPercent Int
  maxPercent Int
  grade      String
  remark     String?
  isPass     Boolean  @default(true)
  sortOrder  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, name, sortOrder])
  @@map("grading_bands")
}

// ─── Students & Guardians ────────────────────────────────────────────────────

model Guardian {
  id                 String   @id @default(cuid())
  schoolId           String
  firstName          String
  lastName           String
  phone              String
  secondaryPhone     String?
  whatsappPhone      String?
  email              String?
  nationalId         String?
  relationship       String
  address            String?
  occupation         String?
  employer           String?
  isFinancialContact Boolean  @default(true)
  portalUserId       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  school                  School                   @relation(fields: [schoolId], references: [id])
  studentGuardians        StudentGuardian[]
  paymentProofs           PaymentProof[]
  attendanceNotifications AttendanceNotification[]

  @@index([schoolId, phone])
  @@map("guardians")
}

model Student {
  id                     String    @id @default(cuid())
  schoolId               String
  admissionNumber        String
  firstName              String
  middleName             String?
  lastName               String
  gender                 String
  dateOfBirth            DateTime
  nationality            String    @default("Zimbabwean")
  birthCertificateNumber String?
  residentialAddress     String?
  city                   String?
  province               String?
  admissionDate          DateTime?
  boardingStatus         String    @default("day_scholar")
  status                 String    @default("active")
  classroomId            String?
  applicationId          String?
  portalUserId           String?
  email                  String?
  medicalAlert           String?
  transferDestination    String?
  transferDate           DateTime?
  transferReason         String?
  photoPath              String?
  zimsecCandidateNumber  String?
  archivedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  school    School     @relation(fields: [schoolId], references: [id])
  classroom Classroom? @relation(fields: [classroomId], references: [id])

  studentGuardians        StudentGuardian[]
  studentEnrollments      StudentEnrollment[]
  studentDocuments        StudentDocument[]
  attendanceEntries       AttendanceEntry[]
  attendanceNotifications AttendanceNotification[]
  onlinePayments          OnlinePayment[]
  paymentProofs           PaymentProof[]
  assessmentMarks         AssessmentMark[]
  reportCards             ReportCard[]
  feeInvoices             FeeInvoice[]
  payments                Payment[]
  paymentAllocations      PaymentAllocation[]
  disciplineIncidents     DisciplineIncident[]
  clinicVisits            ClinicVisit[]
  libraryLoans            LibraryLoan[]
  boardingAllocations     BoardingAllocation[]
  transportAssignments    TransportAssignment[]
  admissionApplications   AdmissionApplication[]
  studentLeaderships      StudentLeadership[]
  studentNotes StudentNote[]
  healthRecord            HealthRecord?
  safeguardingCases       SafeguardingCase[]
  specialNeeds            SpecialNeed[]
  pickupAuthorizations    PickupAuthorization[]
  clubMemberships         ClubMembership[]
  tripParticipants        TripParticipant[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId, status])
  @@index([schoolId, classroomId])
    examSeats ExamSeat[]

  @@map("students")
}

model StudentGuardian {
  studentId        String
  guardianId       String
  relationshipType String  @default("guardian")
  isPrimaryContact Boolean @default(false)
  authorizedPickup Boolean @default(true)

  student  Student  @relation(fields: [studentId], references: [id])
  guardian Guardian @relation(fields: [guardianId], references: [id])

  @@unique([studentId, guardianId])
  @@map("student_guardians")
}

model StudentEnrollment {
  id             String    @id @default(cuid())
  studentId      String
  schoolId       String
  academicYearId String
  gradeLevelId   String
  classroomId    String
  enrollmentDate DateTime
  status         String    @default("active")
  exitDate       DateTime?
  exitReason     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student      Student      @relation(fields: [studentId], references: [id])
  school       School       @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  gradeLevel   GradeLevel   @relation(fields: [gradeLevelId], references: [id])
  classroom    Classroom    @relation(fields: [classroomId], references: [id])

  @@index([studentId, enrollmentDate])
  @@index([schoolId, classroomId, status])
  @@map("student_enrollments")
}

model StudentDocument {
  id           String   @id @default(cuid())
  studentId    String
  schoolId     String
  documentType String
  filename     String
  storageKey   String
  contentType  String
  byteSize     Int
  notes        String?
  uploadedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student    Student          @relation(fields: [studentId], references: [id])
  school     School           @relation(fields: [schoolId], references: [id])
  uploadedBy SchoolMembership @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([studentId])
  @@map("student_documents")
}

// ─── Attendance ──────────────────────────────────────────────────────────────

model AttendanceRegister {
  id             String    @id @default(cuid())
  schoolId       String
  classroomId    String
  academicYearId String?
  registerDate   DateTime
  session        String    @default("morning")
  status         String    @default("draft")
  lockedAt       DateTime?
  lockedById     String?
  submittedById  String
  submittedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  school       School            @relation(fields: [schoolId], references: [id])
  classroom    Classroom         @relation(fields: [classroomId], references: [id])
  academicYear AcademicYear?     @relation(fields: [academicYearId], references: [id])
  submittedBy  SchoolMembership  @relation("RegisterSubmitter", fields: [submittedById], references: [id])
  lockedBy     SchoolMembership? @relation("RegisterLocker", fields: [lockedById], references: [id])

  entries AttendanceEntry[]

  @@unique([schoolId, classroomId, registerDate, session])
  @@map("attendance_registers")
}

model AttendanceEntry {
  id               String    @id @default(cuid())
  registerId       String
  studentId        String
  status           String
  reason           String?
  arrivalTime      String?
  departureTime    String?
  note             String?
  correctedAt      DateTime?
  correctionReason String?
  markedById       String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  register      AttendanceRegister       @relation(fields: [registerId], references: [id])
  student       Student                  @relation(fields: [studentId], references: [id])
  markedBy      SchoolMembership         @relation(fields: [markedById], references: [id])
  notifications AttendanceNotification[]

  @@unique([registerId, studentId])
  @@map("attendance_entries")
}

model AttendanceSettings {
  id                 String   @id @default(cuid())
  schoolId           String   @unique
  schoolDays         String   @default("[1,2,3,4,5]")
  openingTime        String   @default("07:30")
  lateThreshold      String   @default("07:45")
  submissionDeadline String   @default("08:30")
  lockPolicy         String   @default("after_submission")
  warningThreshold   Int      @default(90)
  criticalThreshold  Int      @default(80)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@map("attendance_settings")
}

model AttendanceNotification {
  id                String    @id @default(cuid())
  schoolId          String
  studentId         String
  guardianId        String?
  attendanceEntryId String
  channel           String    @default("internal")
  status            String    @default("queued")
  message           String
  failureReason     String?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  school          School          @relation(fields: [schoolId], references: [id])
  student         Student         @relation(fields: [studentId], references: [id])
  guardian        Guardian?       @relation(fields: [guardianId], references: [id])
  attendanceEntry AttendanceEntry @relation(fields: [attendanceEntryId], references: [id])

  @@index([schoolId, status])
  @@map("attendance_notifications")
}

// ─── Assessment & Results ────────────────────────────────────────────────────

model Assessment {
  id             String    @id @default(cuid())
  schoolId       String
  termId         String
  classSubjectId String
  title          String
  assessmentType String
  component      String    @default("ca") // ca | exam
  maxMarks       Int       @default(100)
  weightPercent  Int       @default(100)
  dueDate        DateTime?
  status         String    @default("draft")
  publishedAt    DateTime?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  school       School           @relation(fields: [schoolId], references: [id])
  term         Term             @relation(fields: [termId], references: [id])
  classSubject ClassSubject     @relation(fields: [classSubjectId], references: [id])
  createdBy    SchoolMembership @relation(fields: [createdById], references: [id])

  marks AssessmentMark[]
  examSessions ExamSession[]

  @@index([schoolId, termId])
  @@index([classSubjectId])
  @@map("assessments")
}

model AssessmentMark {
  id           String   @id @default(cuid())
  assessmentId String
  studentId    String
  score        Int
  comment      String?
  status       String   @default("entered")
  enteredById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assessment Assessment       @relation(fields: [assessmentId], references: [id])
  student    Student          @relation(fields: [studentId], references: [id])
  enteredBy  SchoolMembership @relation(fields: [enteredById], references: [id])

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@map("assessment_marks")
}

model ReportCard {
  id                      String    @id @default(cuid())
  schoolId                String
  studentId               String
  termId                  String
  status                  String    @default("draft")
  classTeacherComment     String?
  headComment             String?
  promotionStatus         String?
  // Snapshot of the learner's grade mode at generation — infant reports hide %.
  descriptorOnly          Boolean   @default(false)
  version                 Int       @default(1)
  classPosition           Int?
  classSize               Int?
  returnedNote            String?
  studentNameSnapshot     String    @default("")
  admissionNumberSnapshot String    @default("")
  classroomSnapshot       String    @default("")
  averagePercent          Int?
  presentSessions         Int       @default(0)
  absentSessions          Int       @default(0)
  verificationCode        String?
  generatedById           String?
  publishedAt             DateTime?
  publishedById           String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  school      School            @relation(fields: [schoolId], references: [id])
  student     Student           @relation(fields: [studentId], references: [id])
  term        Term              @relation(fields: [termId], references: [id])
  generatedBy SchoolMembership? @relation("ReportGenerator", fields: [generatedById], references: [id])
  publishedBy SchoolMembership? @relation("ReportPublisher", fields: [publishedById], references: [id])

  results   ReportCardResult[]
  approvals ReportApproval[]

  @@unique([studentId, termId])
  @@index([schoolId, status])
  @@map("report_cards")
}

model ReportCardResult {
  id                  String   @id @default(cuid())
  schoolId            String
  reportCardId        String
  subjectCodeSnapshot String
  subjectNameSnapshot String
  scorePercent        Int
  caPercent           Int?
  examPercent         Int?
  previousPercent     Int?
  changePercent       Int?
  trend               String?
  grade               String
  remark              String
  assessmentCount     Int
  teacherComment      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  school     School     @relation(fields: [schoolId], references: [id])
  reportCard ReportCard @relation(fields: [reportCardId], references: [id])

  @@unique([reportCardId, subjectCodeSnapshot])
  @@index([schoolId, reportCardId])
  @@map("report_card_results")
}

// ─── Timetable ───────────────────────────────────────────────────────────────

model TimetableEntry {
  id             String   @id @default(cuid())
  schoolId       String
  academicYearId String
  termId         String?
  classroomId    String
  classSubjectId String?
  teacherId      String?
  weekday        Int
  startTime      String
  endTime        String
  entryType      String   @default("lesson")
  title          String?
  room           String?
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School            @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear      @relation(fields: [academicYearId], references: [id])
  term         Term?             @relation(fields: [termId], references: [id])
  classroom    Classroom         @relation(fields: [classroomId], references: [id])
  classSubject ClassSubject?     @relation(fields: [classSubjectId], references: [id])
  teacher      SchoolMembership? @relation("TimetableTeacher", fields: [teacherId], references: [id])

