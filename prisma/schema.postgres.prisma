  term        Term              @relation(fields: [termId], references: [id])
  classroom   Classroom         @relation(fields: [classroomId], references: [id])
  subject     Subject?          @relation(fields: [subjectId], references: [id])
  invigilator SchoolMembership? @relation("ExamInvigilator", fields: [invigilatorId], references: [id])
  assessment  Assessment?        @relation(fields: [assessmentId], references: [id])
  seats       ExamSeat[]

  @@index([schoolId, examDate])
  @@map("exam_sessions")
}

model ExamSeat {
  id            String      @id @default(cuid())
  schoolId      String
  examSessionId String
  studentId     String
  seatNumber    String
  createdAt     DateTime    @default(now())

  school      School      @relation(fields: [schoolId], references: [id])
  examSession ExamSession @relation(fields: [examSessionId], references: [id])
  student     Student     @relation(fields: [studentId], references: [id])

  @@unique([examSessionId, studentId])
  @@map("exam_seats")
}

// ─── Academic operations: weighting, approvals, planning, notifications ───────

// How much continuous assessment vs examination contributes to a subject's
// final mark. One school default row (subjectId null) plus optional
// subject-level overrides.
model ReportWeighting {
  id             String   @id @default(cuid())
  schoolId       String
  subjectId      String?
  caPercent      Int      @default(40)
  examPercent    Int      @default(60)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school  School   @relation(fields: [schoolId], references: [id])
  subject Subject? @relation(fields: [subjectId], references: [id])

  @@unique([schoolId, subjectId])
  @@map("report_weightings")
}

// Immutable sign-off record for each step of the report approval pipeline.
model ReportApproval {
  id          String   @id @default(cuid())
  schoolId    String
  reportCardId String
  step        String   // class_teacher | hod | head | publish
  action      String   // submitted | approved | rejected | published
  actorId     String
  actorName   String
  role        String
  note        String?
  version     Int      @default(1)
  createdAt   DateTime @default(now())

  school     School           @relation(fields: [schoolId], references: [id])
  reportCard ReportCard       @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  actor      SchoolMembership @relation(fields: [actorId], references: [id])

  @@index([schoolId, reportCardId])
  @@map("report_approvals")
}

model LessonPlan {
  id            String    @id @default(cuid())
  schoolId      String
  classSubjectId String
  termId        String?
  teacherId     String
  lessonDate    DateTime
  topic         String
  objectives    String?
  activities    String?
  resources     String?
  homework      String?
  status        String    @default("planned") // planned | delivered
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  school       School           @relation(fields: [schoolId], references: [id])
  classSubject ClassSubject     @relation(fields: [classSubjectId], references: [id])
  term         Term?            @relation(fields: [termId], references: [id])
  teacher      SchoolMembership @relation(fields: [teacherId], references: [id])

  @@index([schoolId, teacherId])
  @@map("lesson_plans")
}

// Private academic observations — deliberately separate from report comments.
model StudentNote {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  subjectId String?
  authorId  String
  note      String
  createdAt DateTime @default(now())

  school   School           @relation(fields: [schoolId], references: [id])
  student  Student          @relation(fields: [studentId], references: [id])
  subject  Subject?         @relation(fields: [subjectId], references: [id])
  author   SchoolMembership @relation(fields: [authorId], references: [id])

  @@index([schoolId, studentId])
  @@map("student_notes")
}

model Notification {
  id           String    @id @default(cuid())
  schoolId     String
  membershipId String
  title        String
  body         String
  link         String?
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  school     School           @relation(fields: [schoolId], references: [id])
  membership SchoolMembership @relation(fields: [membershipId], references: [id])

  @@index([schoolId, membershipId, readAt])
  @@map("notifications")
}


model HealthRecord {
  id                String    @id @default(cuid())
  schoolId          String
  studentId         String    @unique
  bloodGroup        String?
  allergies         String?
  chronicConditions String?
  medications       String?
  disabilities      String?
  doctorName        String?
  doctorPhone       String?
  medicalAid        String?
  emergencyNotes    String?
  updatedById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@map("health_records")
}

model SafeguardingCase {
  id          String    @id @default(cuid())
  schoolId    String
  studentId   String
  reporterId  String
  concernType String
  details     String
  status      String    @default("open")
  officerId   String?
  actions     String?
  followUpAt  DateTime?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  school   School            @relation(fields: [schoolId], references: [id])
  student  Student           @relation(fields: [studentId], references: [id])
  reporter SchoolMembership  @relation("SafeguardingReporter", fields: [reporterId], references: [id])
  officer  SchoolMembership? @relation("SafeguardingOfficer", fields: [officerId], references: [id])

  @@index([schoolId, status])
  @@map("safeguarding_cases")
}

model SpecialNeed {
  id                String    @id @default(cuid())
  schoolId          String
  studentId         String
  category          String
  assessmentSummary String?
  interventionPlan  String?
  accommodations    String?
  responsibleId     String?
  targets           String?
  reviewDate        DateTime?
  status            String    @default("active")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  school      School            @relation(fields: [schoolId], references: [id])
  student     Student           @relation(fields: [studentId], references: [id])
  responsible SchoolMembership? @relation(fields: [responsibleId], references: [id])

  @@index([schoolId, studentId])
  @@map("special_needs")
}

model Assignment {
  id             String    @id @default(cuid())
  schoolId       String
  classSubjectId String
  title          String
  instructions   String?
  publishAt      DateTime?
  dueDate        DateTime
  status         String    @default("published")
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  school       School           @relation(fields: [schoolId], references: [id])
  classSubject ClassSubject     @relation(fields: [classSubjectId], references: [id])
  createdBy    SchoolMembership @relation(fields: [createdById], references: [id])

  @@index([schoolId, classSubjectId])
  @@map("assignments")
}

model CurriculumTopic {
  id             String    @id @default(cuid())
  schoolId       String
  classSubjectId String
  title          String
  objectives     String?
  orderIndex     Int       @default(0)
  status         String    @default("not_started")
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  school       School       @relation(fields: [schoolId], references: [id])
  classSubject ClassSubject @relation(fields: [classSubjectId], references: [id])

  @@index([schoolId, classSubjectId])
  @@map("curriculum_topics")
}

model PickupAuthorization {
  id             String    @id @default(cuid())
  schoolId       String
  studentId      String
  name           String
  relationship   String
  phone          String
  idNumber       String?
  validFrom      DateTime?
  validTo        DateTime?
  status         String    @default("active")
  authorizedById String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  school       School           @relation(fields: [schoolId], references: [id])
  student      Student          @relation(fields: [studentId], references: [id])
  authorizedBy SchoolMembership @relation(fields: [authorizedById], references: [id])

  @@index([schoolId, studentId])
  @@map("pickup_authorizations")
}

model Club {
  id            String    @id @default(cuid())
  schoolId      String
  name          String
  category      String?
  coordinatorId String?
  schedule      String?
  status        String    @default("active")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  school      School            @relation(fields: [schoolId], references: [id])
  coordinator SchoolMembership? @relation(fields: [coordinatorId], references: [id])
  members     ClubMembership[]

  @@map("clubs")
}

model ClubMembership {
  id        String    @id @default(cuid())
  schoolId  String
  clubId    String
  studentId String
  role      String?
  joinedAt  DateTime  @default(now())
  status    String    @default("active")

  school  School  @relation(fields: [schoolId], references: [id])
  club    Club    @relation(fields: [clubId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([clubId, studentId])
  @@map("club_memberships")
}

model SchoolTrip {
  id            String    @id @default(cuid())
  schoolId      String
  title         String
  destination   String
  startDate     DateTime
  endDate       DateTime
  costMinor     Int       @default(0)
  currency      String    @default("USD")
  coordinatorId String?
  status        String    @default("planned")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  school       School            @relation(fields: [schoolId], references: [id])
  coordinator  SchoolMembership? @relation(fields: [coordinatorId], references: [id])
  participants TripParticipant[]

  @@map("school_trips")
}

model TripParticipant {
  id            String    @id @default(cuid())
  schoolId      String
  tripId        String
  studentId     String
  consentStatus String    @default("pending")
  consentBy     String?
  consentAt     DateTime?
  paidMinor     Int       @default(0)
  status        String    @default("registered")

  school  School     @relation(fields: [schoolId], references: [id])
  trip    SchoolTrip @relation(fields: [tripId], references: [id])
  student Student    @relation(fields: [studentId], references: [id])

  @@unique([tripId, studentId])
  @@map("trip_participants")
}

model StaffAttendance {
  id           String           @id @default(cuid())
  schoolId     String
  staffId      String
  registerDate DateTime
  status       String           @default("present")
  note         String?
  recordedById String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  school       School           @relation(fields: [schoolId], references: [id])
  staff        StaffProfile     @relation(fields: [staffId], references: [id])
  recordedBy   SchoolMembership @relation(fields: [recordedById], references: [id])

  @@unique([staffId, registerDate])
  @@index([schoolId, registerDate])
  @@map("staff_attendance")
}

model OnlinePayment {
  id             String   @id @default(cuid())
  schoolId       String
  studentId      String
  initiatedById  String
  reference      String
  amountMinor    Int
  currency       String
  pollUrl        String?
  paynowRef      String?
  status         String   @default("pending")
  paymentId      String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School           @relation(fields: [schoolId], references: [id])
  student      Student          @relation(fields: [studentId], references: [id])
  initiatedBy  SchoolMembership @relation(fields: [initiatedById], references: [id])
  payment      Payment?         @relation(fields: [paymentId], references: [id])

  @@unique([schoolId, reference])
  @@index([schoolId, status])
  @@map("online_payments")
}

model PaymentProof {
  id           String           @id @default(cuid())
  schoolId     String
  studentId    String
  guardianId   String
  amountMinor  Int
  currency     String
  method       String           @default("bank_transfer")
  reference    String?
  note         String?
  filename     String
  storageKey   String
  contentType  String
  byteSize     Int
  status       String           @default("pending")
  reviewedById String?
  reviewNote   String?
  reviewedAt   DateTime?
  paymentId    String?          @unique
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  school     School            @relation(fields: [schoolId], references: [id])
  student    Student           @relation(fields: [studentId], references: [id])
  guardian   Guardian          @relation(fields: [guardianId], references: [id])
  reviewedBy SchoolMembership? @relation(fields: [reviewedById], references: [id])
  payment    Payment?          @relation(fields: [paymentId], references: [id])

  @@index([schoolId, status])
  @@map("payment_proofs")
}
