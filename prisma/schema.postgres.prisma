// ─── Finance ─────────────────────────────────────────────────────────────────

model FeeInvoice {
  id                      String    @id @default(cuid())
  schoolId                String
  studentId               String
  termId                  String?
  invoiceNumber           String
  issueDate               DateTime
  dueDate                 DateTime
  currency                String
  state                   String    @default("building")
  totalMinor              Int
  notes                   String?
  studentNameSnapshot     String
  admissionNumberSnapshot String
  issuerNameSnapshot      String
  createdById             String
  issuedAt                DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  school    School           @relation(fields: [schoolId], references: [id])
  student   Student          @relation(fields: [studentId], references: [id])
  term      Term?            @relation(fields: [termId], references: [id])
  createdBy SchoolMembership @relation(fields: [createdById], references: [id])

  items              FeeInvoiceItem[]
  paymentAllocations PaymentAllocation[]
  financeReversals   FinanceReversal[]

  @@unique([schoolId, invoiceNumber])
  @@index([schoolId, studentId])
  @@index([schoolId, state])
  @@map("fee_invoices")
}

model FeeInvoiceItem {
  id              String   @id @default(cuid())
  schoolId        String
  invoiceId       String
  position        Int
  description     String
  category        String
  quantity        Int      @default(1)
  unitAmountMinor Int
  createdAt       DateTime @default(now())

