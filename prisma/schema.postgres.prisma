  invoice FeeInvoice @relation(fields: [invoiceId], references: [id])

  @@unique([schoolId, invoiceId, position])
  @@index([invoiceId])
  @@map("fee_invoice_items")
}

model FeeTemplate {
  id           String   @id @default(cuid())
  schoolId     String
  name         String
  description  String?
  gradeLevelId String?
  currency     String   @default("USD")
  items        String   @default("[]")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school     School      @relation(fields: [schoolId], references: [id])
  gradeLevel GradeLevel? @relation(fields: [gradeLevelId], references: [id])

  @@unique([schoolId, name])
  @@map("fee_templates")
}

model Payment {
  id                      String   @id @default(cuid())
  schoolId                String
  studentId               String
  receiptNumber           String
  paymentDate             DateTime
  method                  String
  currency                String
  amountMinor             Int
  reference               String?
  payerNameSnapshot       String
  studentNameSnapshot     String
  admissionNumberSnapshot String
  issuerNameSnapshot      String
  exchangeRate            Float?
  recordedById            String
  recordedAt              DateTime @default(now())

  school     School           @relation(fields: [schoolId], references: [id])
  student    Student          @relation(fields: [studentId], references: [id])
  recordedBy SchoolMembership @relation(fields: [recordedById], references: [id])

  paymentAllocations PaymentAllocation[]
  onlinePayment      OnlinePayment?
  paymentProof       PaymentProof?
  financeReversals   FinanceReversal[]

  @@unique([schoolId, receiptNumber])
  @@index([schoolId, studentId])
  @@map("payments")
}

model PaymentAllocation {
  id            String   @id @default(cuid())
  schoolId      String
  studentId     String
  currency      String
  paymentId     String
  invoiceId     String
  amountMinor   Int
  allocatedById String
  allocatedAt   DateTime @default(now())

  school           School            @relation(fields: [schoolId], references: [id])
  student          Student           @relation(fields: [studentId], references: [id])
  payment          Payment           @relation(fields: [paymentId], references: [id])
  invoice          FeeInvoice        @relation(fields: [invoiceId], references: [id])
  allocatedBy      SchoolMembership  @relation(fields: [allocatedById], references: [id])
  financeReversals FinanceReversal[]

  @@index([schoolId, paymentId])
  @@index([schoolId, invoiceId])
  @@map("payment_allocations")
}

model FinanceReversal {
  id             String   @id @default(cuid())
  schoolId       String
  reversalNumber String
  invoiceId      String?
  paymentId      String?
  allocationId   String?
  currency       String
  amountMinor    Int
  reason         String
  reversalDate   DateTime
  reversedById   String
  createdAt      DateTime @default(now())

  school     School             @relation(fields: [schoolId], references: [id])
  invoice    FeeInvoice?        @relation(fields: [invoiceId], references: [id])
  payment    Payment?           @relation(fields: [paymentId], references: [id])
  allocation PaymentAllocation? @relation(fields: [allocationId], references: [id])
  reversedBy SchoolMembership   @relation(fields: [reversedById], references: [id])

  @@unique([schoolId, reversalNumber])
  @@map("finance_reversals")
}

model FinanceIdempotencyKey {
  schoolId          String
  operation         String
  idempotencyKey    String
  requestHash       String
  actorMembershipId String
  responseStatus    Int
  responseJson      String
  createdAt         DateTime @default(now())

  school          School           @relation(fields: [schoolId], references: [id])
  actorMembership SchoolMembership @relation(fields: [actorMembershipId], references: [id])

  @@id([schoolId, operation, idempotencyKey])
  @@map("finance_idempotency_keys")
}

