# ── Local development (SQLite — no Docker required) ──────────────────────────
DATABASE_URL="file:./dev.db"

# Auth.js
AUTH_SECRET="your-random-secret-key-change-this-in-production"
AUTH_URL="http://localhost:3000"  # LAN deploy: http://<server-ip>:3000
AUTH_TRUST_HOST="true"  # required for LAN/proxy origins
NEXT_PUBLIC_APP_URL="http://localhost:3000"  # LAN deploy: http://<server-ip>:3000
# Production requires shared request protection. Docker Compose supplies a
# private Redis instance by default; use a managed Redis URL for multi-host deployment.
# REDIS_URL="redis://localhost:6379"
# TRUST_PROXY="true" # only behind a reverse proxy that overwrites forwarded IP headers

# S3-compatible production document storage (AWS S3, Cloudflare R2, MinIO, etc.)
# Leave blank for local development, which stores files in data/uploads.
# OBJECT_STORAGE_ENDPOINT="https://<provider-endpoint>"
# OBJECT_STORAGE_BUCKET="nyashavee-documents"
# OBJECT_STORAGE_ACCESS_KEY_ID="..."
# OBJECT_STORAGE_SECRET_ACCESS_KEY="..."
# OBJECT_STORAGE_REGION="auto"
# Optional Docker host port override when another local app already uses 3000.
# NYASHAVEE_PORT="3001"

# ── Docker / production (PostgreSQL) ─────────────────────────────────────────
# DATABASE_URL="postgresql://nyashavee:URL_ENCODED_PASSWORD@localhost:5432/nyashavee"
# IMPORTANT: append a connection pool — the default (9) starves under even
# modest concurrency and requests time out at the pool instead of the DB.
# ?connection_limit=60&pool_timeout=20 is right for a single school server.
# The app keeps two Prisma schema variants:
#   prisma/schema.prisma          -> provider sqlite    (local dev)
#   prisma/schema.postgres.prisma -> provider postgresql (Docker/production)
# Push the postgres schema with:
#   npx prisma db push --schema prisma/schema.postgres.prisma

# Message delivery (optional — without these, email/SMS stays queued)
# RESEND_API_KEY="re_..."
# RESEND_FROM="Nyashavee Primary <notices@yourdomain.co.zw>"
# SMS_WEBHOOK_URL="https://your-sms-gateway/send"

# Online payments (Paynow Zimbabwe) — required before parents can pay fees online.
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
